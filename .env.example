# CREWAL Platform Environment Configuration

# Server Port (default: 8000)
PORT=8000

# Server Environment (development / production)
APP_ENV=development

# Optional: Google Gemini API Key for live LLM reasoning across all 10 agents
# If left blank, all agents operate seamlessly using their deterministic fallback generators.
# Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=
